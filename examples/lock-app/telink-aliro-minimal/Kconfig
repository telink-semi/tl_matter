mainmenu "Matter Telink Lock Example Application"

config SETTINGS_NVS_NAME_CACHE
    default y

config SETTINGS_NVS_NAME_CACHE_SIZE
    default 256

config CSA_TEST_CREDENTIALS
    bool "Lab only: preload the CSA BLE RKE test credentials"
    depends on ALIRO_TRANSPORT_BLE
    default n
    help
      Preload the public CSA Test Tool demo reader identity and group
      identifiers, and authorize the matching demo endpoint. This makes the
      BLE-only FFF2 advertiser available without a separate chip-tool Aliro
      provisioning step. The fixed private key and endpoint authorization
      bypass are suitable only for controlled interoperability testing.

menu "Aliro configuration"

config ALIRO_TRANSPORT_NFC
    default y
    select GPIO
    select SPI


config ALIRO_TRANSPORT_BLE
    default n if SOC_RISCV_TELINK_TL323X
    default y if SOC_RISCV_TELINK_TL721X
    select BT
    select BT_PERIPHERAL
    select BT_HOST_CRYPTO
    select BT_SMP
    select BT_L2CAP_DYNAMIC_CHANNEL
config ALIRO_ONLY_BLE_FLOW_SUPP
    default y

config ALIRO_BLE_UWB_FLOW_SUPP
    default y

config ALIRO_NFC_POLLER_THREAD_STACK_SIZE
    default 4096

config ALIRO_LOG_LEVEL
    range 0 4
    default 3
    help
      Keep protocol logging at informational level for normal builds. Level 4
      exposes ephemeral and derived transaction keys and is for controlled
      development only.
config ALIRO_FAST_TRANSACTION
    default n

config ALIRO_KEYSLOT_CREDENTIALS
    default n

endmenu

rsource "../../../config/telink/chip-module/Kconfig.defaults"

source "$(TELINK_ALIRO_ROOT)/Kconfig"
