/ {
	aliases {
		fmirq = &aliro_nfc_irq;
		fmreset = &aliro_nfc_reset;
	};

	keys {
		compatible = "gpio-keys";

		aliro_nfc_irq: aliro_nfc_irq {
			label = "ALIRO_NFC_IRQ";
			gpios = <&gpiod 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		};
	};

	leds {
		compatible = "gpio-leds";

		aliro_nfc_reset: aliro_nfc_reset {
			gpios = <&gpiod 1 GPIO_ACTIVE_HIGH>;
			label = "ALIRO_NFC_RESET";
		};
	};
};

&gpioc {
	interrupts = <27 1>;
	status = "okay";
};

&lspi {
	nfc0: st25r@0 {
		compatible = "st,st25r";
		reg = <0>;
		spi-max-frequency = <10000000>;
		irq-gpios = <&gpiod 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
	};
};

&gspi {
	uwb0: sr150@0 {
		compatible = "nxp,sr150";
		reg = <0>;
		spi-max-frequency = <8000000>;
		irq-gpios = <&gpioc 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		reset-gpios = <&gpioc 5 GPIO_ACTIVE_HIGH>;
		wakeup-gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>;
	};
};

/* one application image with OTA disabled, including SR150 firmware. */
&flash {
	/delete-node/ partitions;
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		slot0_partition: partition@0 {
			label = "image-0";
			reg = <0x0 0x1f1000>;
		};

		factory_partition: partition@1f1000 {
			label = "factory-data";
			reg = <0x1f1000 0x1000>;
		};

		storage_partition: partition@1f2000 {
			label = "storage";
			reg = <0x1f2000 0xc000>;
		};

		vendor_partition: partition@1fe000 {
			label = "vendor-data";
			reg = <0x1fe000 0x2000>;
		};
	};
};
