/ {
	aliases {
		fmirq = &aliro_nfc_irq;
		fmreset = &aliro_nfc_reset;
	};

	keys {
		compatible = "gpio-keys";

		aliro_nfc_irq: aliro_nfc_irq {
			label = "ALIRO_NFC_IRQ";
			gpios = <&gpiod 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		};
	};

	leds {
		compatible = "gpio-leds";

		aliro_nfc_reset: aliro_nfc_reset {
			gpios = <&gpiod 1 GPIO_ACTIVE_HIGH>;
			label = "ALIRO_NFC_RESET";
		};
	};
};

&gpioc {
	interrupts = <27 1>;
	status = "okay";
};

&lspi {
	nfc0: st25r@0 {
		compatible = "st,st25r";
		reg = <0>;
		spi-max-frequency = <10000000>;
		irq-gpios = <&gpiod 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
	};
};

&gspi {
	uwb0: sr150@0 {
		compatible = "nxp,sr150";
		reg = <0>;
		spi-max-frequency = <8000000>;
		irq-gpios = <&gpioc 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		reset-gpios = <&gpioc 5 GPIO_ACTIVE_HIGH>;
		wakeup-gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>;
	};
};
